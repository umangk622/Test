    /* =========================================================
       CBT TEST ENGINE & CONTROLLER
       ========================================================= */
    function startExamInstructions(examId) {
      const exam = INITIAL_EXAMS.find(e => e.id === examId) || INITIAL_EXAMS[0];
      currentExam = exam;
      document.getElementById('inst-exam-name').textContent = `${exam.name} CBT Stage-1 Mock Test`;
      document.getElementById('inst-confirm-check').checked = false;
      navigateTo('instructions');
    }

    function generateSessionId() {
      const rand = Math.random().toString(36).substring(2, 8).toUpperCase();
      const code = Math.floor(1000 + Math.random() * 9000);
      return `RPP-CBT-${rand}-${code}`;
    }

    function launchCBTTest() {
      const check = document.getElementById('inst-confirm-check');
      if (!check.checked) {
        alert("Please acknowledge that you have read and understood the instructions.");
        return;
      }

      // Load questions from local storage
      const allQ = JSON.parse(localStorage.getItem('rpp_questions')) || INITIAL_QUESTIONS;
      testQuestions = allQ.slice(0, 20); // 20 questions

      // Initialize states
      questionStates = testQuestions.map(() => ({
        visited: false,
        answered: false,
        markedForReview: false,
        selectedAnswer: null
      }));

      // Question 1 visited initially
      questionStates[0].visited = true;
      currentQIndex = 0;
      isSubmitting = false;
      currentSessionId = generateSessionId();

      document.getElementById('cbt-session-display').textContent = currentSessionId;
      document.getElementById('cbt-header-exam-name').textContent = currentExam.name + " CBT Mock";

      // Build Palette buttons
      const palGrid = document.getElementById('cbt-palette-grid');
      palGrid.innerHTML = "";
      for (let i = 0; i < testQuestions.length; i++) {
        const btn = document.createElement('button');
        btn.className = 'palette-btn bg-not-visited';
        btn.id = `palette-btn-${i}`;
        btn.textContent = i + 1;
        btn.onclick = () => jumpToQuestion(i);
        palGrid.appendChild(btn);
      }

      // Show CBT Screen full screen
      document.getElementById('cbt-screen').classList.remove('hidden');

      // Start 90 mins timer
      secondsLeft = 90 * 60;
      startCbtTimer();

      renderQuestion(currentQIndex);
      updatePaletteUI();
    }

    function startCbtTimer() {
      clearInterval(testTimerInterval);
      const timerDisplay = document.getElementById('cbt-timer-display');
      const timeStr = document.getElementById('cbt-time-string');

      function tick() {
        if (secondsLeft <= 0) {
          clearInterval(testTimerInterval);
          timeStr.textContent = "00:00";
          showToast("Time expired! Automatically submitting test...");
          executeFinalSubmit();
          return;
        }

        const mins = Math.floor(secondsLeft / 60);
        const secs = secondsLeft % 60;
        timeStr.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

        // Warnings at 5 mins and 1 min
        if (secondsLeft <= 60) {
          timerDisplay.className = "cbt-timer timer-danger";
        } else if (secondsLeft <= 300) {
          timerDisplay.className = "cbt-timer timer-warning";
        } else {
          timerDisplay.className = "cbt-timer";
        }

        secondsLeft--;
      }

      tick();
      testTimerInterval = setInterval(tick, 1000);
    }

    function renderQuestion(index) {
      currentQIndex = index;
      const q = testQuestions[index];
      const state = questionStates[index];
      state.visited = true;

      document.getElementById('cbt-q-counter').textContent = `Question ${index + 1} of ${testQuestions.length}`;
      document.getElementById('cbt-q-subject').textContent = q.subject || "General Study";
      document.getElementById('cbt-question-text').textContent = `Q.${index + 1}: ${q.question}`;

      const optsContainer = document.getElementById('cbt-options-container');
      optsContainer.innerHTML = "";

      const optLetters = ['A', 'B', 'C', 'D'];
      q.options.forEach((optText, optIdx) => {
        const isSel = state.selectedAnswer === optIdx;
        const optDiv = document.createElement('div');
        optDiv.className = `cbt-option ${isSel ? 'selected' : ''}`;
        optDiv.innerHTML = `
          <div class="opt-circle">${optLetters[optIdx]}</div>
          <div>${optText}</div>
        `;
        optDiv.onclick = () => selectOption(optIdx);
        optsContainer.appendChild(optDiv);
      });

      document.getElementById('cbt-btn-prev').disabled = index === 0;
      updatePaletteUI();
    }

    function selectOption(optIdx) {
      const state = questionStates[currentQIndex];
      state.selectedAnswer = optIdx;
      state.answered = true;
      renderQuestion(currentQIndex);
    }

    function clearSelectedOption() {
      const state = questionStates[currentQIndex];
      state.selectedAnswer = null;
      state.answered = false;
      renderQuestion(currentQIndex);
      showToast("Response cleared");
    }

    function markForReview() {
      const state = questionStates[currentQIndex];
      state.markedForReview = !state.markedForReview;
      showToast(state.markedForReview ? "Marked for review" : "Unmarked from review");
      updatePaletteUI();
    }

    function saveAndNext() {
      const state = questionStates[currentQIndex];
      if (state.selectedAnswer !== null) {
        state.answered = true;
      }
      if (currentQIndex < testQuestions.length - 1) {
        currentQIndex++;
        renderQuestion(currentQIndex);
      } else {
        showToast("Reached last question. Review or submit test.");
      }
    }

    function prevQuestion() {
      if (currentQIndex > 0) {
        currentQIndex--;
        renderQuestion(currentQIndex);
      }
    }

    function jumpToQuestion(index) {
      if (index >= 0 && index < testQuestions.length) {
        renderQuestion(index);
        // On mobile close palette after selection
        document.getElementById('cbt-palette-drawer').classList.remove('open');
      }
    }

    function toggleMobilePalette() {
      document.getElementById('cbt-palette-drawer').classList.toggle('open');
    }

    function updatePaletteUI() {
      let ans = 0, rev = 0, vis = 0, unvisited = 0;

      questionStates.forEach((st, idx) => {
        const btn = document.getElementById(`palette-btn-${idx}`);
        if (!btn) return;

        btn.className = "palette-btn";
        if (idx === currentQIndex) {
          btn.classList.add('active-q');
        }

        if (st.markedForReview) {
          btn.classList.add('bg-review');
          rev++;
        } else if (st.answered && st.selectedAnswer !== null) {
          btn.classList.add('bg-answered');
          ans++;
        } else if (st.visited) {
          btn.classList.add('bg-visited');
          vis++;
        } else {
          btn.classList.add('bg-not-visited');
          unvisited++;
        }
      });

      document.getElementById('pal-count-ans').textContent = ans;
      document.getElementById('pal-count-rev').textContent = rev;
      document.getElementById('pal-count-vis').textContent = vis;
      document.getElementById('pal-count-left').textContent = unvisited;
    }

    /* =========================================================
       SUBMIT MODAL & RESULT CALCULATION (NEGATIVE MARKING)
       ========================================================= */
    function confirmSubmitTest() {
      let ans = 0, rev = 0, unans = 0;
      questionStates.forEach(st => {
        if (st.answered && st.selectedAnswer !== null) ans++;
        else unans++;
        if (st.markedForReview) rev++;
      });

      document.getElementById('modal-summary-ans').textContent = ans;
      document.getElementById('modal-summary-unans').textContent = unans;
      document.getElementById('modal-summary-rev').textContent = rev;
      document.getElementById('submit-confirm-modal').classList.remove('hidden');
    }

    function closeSubmitModal() {
      document.getElementById('submit-confirm-modal').classList.add('hidden');
    }

    function executeFinalSubmit() {
      if (isSubmitting) return;
      isSubmitting = true;
      closeSubmitModal();
      clearInterval(testTimerInterval);

      // Calculate Negative Marking Score
      let correctCount = 0;
      let wrongCount = 0;
      let unattemptedCount = 0;

      testQuestions.forEach((q, idx) => {
        const st = questionStates[idx];
        if (st.selectedAnswer === null || st.selectedAnswer === undefined) {
          unattemptedCount++;
        } else if (st.selectedAnswer === q.answer) {
          correctCount++;
        } else {
          wrongCount++;
        }
      });

      const positiveMarks = correctCount * 1.00;
      const negativeMarks = wrongCount * 0.33;
      const finalScore = Math.max(0, positiveMarks - negativeMarks).toFixed(2);
      const attempted = correctCount + wrongCount;
      const accuracy = attempted > 0 ? ((correctCount / attempted) * 100).toFixed(1) : "0.0";

      const attemptRecord = {
        sessionId: currentSessionId,
        examName: currentExam.name,
        candidateName: currentUser ? (currentUser.name || currentUser.username) : "Guest Aspirant",
        userEmail: currentUser ? currentUser.email : "guest@railpathshala.test",
        username: currentUser ? currentUser.username : "guest",
        date: new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }),
        totalQuestions: 20,
        attempted: attempted,
        correct: correctCount,
        wrong: wrongCount,
        unattempted: unattemptedCount,
        posMarks: positiveMarks.toFixed(2),
        negMarks: negativeMarks.toFixed(2),
        finalScore: finalScore,
        accuracy: accuracy
      };

      // Save to LocalStorage attempts
      const allAttempts = JSON.parse(localStorage.getItem('rpp_attempts')) || [];
      allAttempts.push(attemptRecord);
      localStorage.setItem('rpp_attempts', JSON.stringify(allAttempts));

      // Hide CBT screen
      document.getElementById('cbt-screen').classList.add('hidden');

      // Trigger 5-second Thank You Splash
      const splash = document.getElementById('splash-screen');
      splash.classList.remove('hidden');

      setTimeout(() => {
        splash.classList.add('hidden');
        renderResultView(attemptRecord);
        navigateTo('result');
      }, 4800);
    }

    function renderResultView(res) {
      document.getElementById('res-score-display').textContent = `Score: ${res.finalScore} / 20.00`;
      document.getElementById('res-candidate-name').textContent = `Candidate: ${res.candidateName} | ${res.examName}`;
      document.getElementById('res-session-tag').textContent = `Session ID: ${res.sessionId} • Date: ${res.date}`;

      document.getElementById('res-attempted').textContent = res.attempted;
      document.getElementById('res-correct').textContent = res.correct;
      document.getElementById('res-wrong').textContent = res.wrong;
      document.getElementById('res-pos-marks').textContent = `+${res.posMarks}`;
      document.getElementById('res-neg-marks').textContent = `-${res.negMarks}`;

      const accVal = parseFloat(res.accuracy);
      document.getElementById('res-donut-pct').textContent = `${accVal}%`;
      document.getElementById('res-bar-acc-val').textContent = `${accVal}%`;
      document.getElementById('res-bar-acc').style.width = `${accVal}%`;

      const attPct = ((res.attempted / 20) * 100).toFixed(0);
      document.getElementById('res-bar-att-val').textContent = `${attPct}%`;
      document.getElementById('res-bar-att').style.width = `${attPct}%`;

      // CSS Conic Gradient Donut
      const correctDeg = (res.correct / 20) * 360;
      const wrongDeg = (res.wrong / 20) * 360;
      document.getElementById('res-donut-chart').style.background = `
        conic-gradient(
          #10b981 0deg ${correctDeg}deg,
          #ef4444 ${correctDeg}deg ${correctDeg + wrongDeg}deg,
          #cbd5e1 ${correctDeg + wrongDeg}deg 360deg
        )
      `;
    }

    function viewHistoricalResult(sessionId) {
      const allAttempts = JSON.parse(localStorage.getItem('rpp_attempts')) || [];
      const record = allAttempts.find(a => a.sessionId === sessionId);
      if (record) {
        renderResultView(record);
        navigateTo('result');
      }
    }

    /* =========================================================
       ADMIN CONTROL PANEL (CLIENT-SIDE MVC)
       ========================================================= */
    function checkAdminSession() {
      const isAdm = sessionStorage.getItem('rpp_admin_logged');
      if (isAdm === 'true') {
        document.getElementById('admin-login-box').classList.add('hidden');
        document.getElementById('admin-workspace').classList.remove('hidden');
        renderAdminStats();
      } else {
        document.getElementById('admin-login-box').classList.remove('hidden');
        document.getElementById('admin-workspace').classList.add('hidden');
      }
    }

    function handleAdminLogin(e) {
      e.preventDefault();
      const mail = document.getElementById('admin-email').value.trim();
      const pass = document.getElementById('admin-password').value;
      if (mail === 'admin@railpathshala.test' && pass === 'Admin@12345') {
        sessionStorage.setItem('rpp_admin_logged', 'true');
        showToast("Admin access granted ✓");
        checkAdminSession();
      } else {
        alert("Invalid Admin Credentials!");
      }
    }

    function handleAdminLogout() {
      sessionStorage.removeItem('rpp_admin_logged');
      showToast("Admin session ended");
      checkAdminSession();
    }

    function setAdminTab(tab) {
      ['dash', 'questions', 'add-q', 'students', 'results'].forEach(t => {
        document.getElementById(`admin-tab-${t}`).classList.toggle('hidden', t !== tab);
      });

      if (tab === 'questions') renderAdminQuestions();
      if (tab === 'students') renderAdminStudents();
      if (tab === 'results') renderAdminResults();
      if (tab === 'dash') renderAdminStats();
    }

    function renderAdminStats() {
      const users = JSON.parse(localStorage.getItem('rpp_users')) || [];
      const qs = JSON.parse(localStorage.getItem('rpp_questions')) || [];
      const atts = JSON.parse(localStorage.getItem('rpp_attempts')) || [];

      document.getElementById('adm-stat-students').textContent = users.length;
      document.getElementById('adm-stat-questions').textContent = qs.length;
      document.getElementById('adm-stat-attempts').textContent = atts.length;
    }

    function renderAdminQuestions() {
      const qs = JSON.parse(localStorage.getItem('rpp_questions')) || [];
      const tbody = document.getElementById('adm-questions-tbody');
      tbody.innerHTML = qs.map((q, idx) => `
        <tr>
          <td>${q.id || (idx + 1)}</td>
          <td><span class="badge badge-primary">${q.subject || 'GS'}</span></td>
          <td style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${q.question}</td>
          <td><b>Opt ${['A', 'B', 'C', 'D'][q.answer]}</b></td>
          <td>
            <button class="btn btn-sm btn-danger" onclick="deleteQuestion(${idx})">Delete</button>
          </td>
        </tr>
      `).join('');
    }

    function handleAdminAddQuestion(e) {
      e.preventDefault();
      const sub = document.getElementById('add-q-subject').value;
      const text = document.getElementById('add-q-text').value.trim();
      const o0 = document.getElementById('add-q-opt0').value.trim();
      const o1 = document.getElementById('add-q-opt1').value.trim();
      const o2 = document.getElementById('add-q-opt2').value.trim();
      const o3 = document.getElementById('add-q-opt3').value.trim();
      const ans = parseInt(document.getElementById('add-q-answer').value);
      const exp = document.getElementById('add-q-exp').value.trim();

      const newQ = {
        id: Date.now(),
        subject: sub,
        question: text,
        options: [o0, o1, o2, o3],
        answer: ans,
        explanation: exp || "Standard solved answer."
      };

      const qs = JSON.parse(localStorage.getItem('rpp_questions')) || [];
      qs.unshift(newQ);
      localStorage.setItem('rpp_questions', JSON.stringify(qs));

      showToast("Question added successfully ✓");
      e.target.reset();
      setAdminTab('questions');
    }

    function deleteQuestion(idx) {
      if (confirm("Are you sure you want to remove this question?")) {
        const qs = JSON.parse(localStorage.getItem('rpp_questions')) || [];
        qs.splice(idx, 1);
        localStorage.setItem('rpp_questions', JSON.stringify(qs));
        showToast("Question deleted ✓");
        renderAdminQuestions();
      }
    }

    function renderAdminStudents() {
      const users = JSON.parse(localStorage.getItem('rpp_users')) || [];
      const atts = JSON.parse(localStorage.getItem('rpp_attempts')) || [];
      const tbody = document.getElementById('adm-students-tbody');

      tbody.innerHTML = users.map(u => {
        const myAtts = atts.filter(a => a.userEmail === u.email || a.username === u.username);
        return `
          <tr>
            <td><strong>${u.name || 'Student'}</strong></td>
            <td>${u.email}</td>
            <td>${u.phone || 'N/A'}</td>
            <td>${u.username}</td>
            <td><span class="badge badge-primary">${myAtts.length} Tests</span></td>
            <td><span class="badge badge-success">Active</span></td>
          </tr>
        `;
      }).join('');
    }

    function renderAdminResults() {
      const atts = JSON.parse(localStorage.getItem('rpp_attempts')) || [];
      const tbody = document.getElementById('adm-results-tbody');
      tbody.innerHTML = atts.slice().reverse().map(a => `
        <tr>
          <td>${a.candidateName}</td>
          <td>${a.examName}</td>
          <td><code style="font-family: var(--font-mono);">${a.sessionId}</code></td>
          <td><strong>${a.finalScore}</strong> / 20</td>
          <td>${a.accuracy}%</td>
          <td>${a.date}</td>
        </tr>
      `).join('');
    }

    /* =========================================================
       INITIAL APPLICATION LOAD
       ========================================================= */
    window.addEventListener('DOMContentLoaded', () => {
      // Populate popular exams on home page
      renderExamsGrid('home-exams-grid', INITIAL_EXAMS.slice(0, 6));
      updateNavbar();
    });
  </script>
</body>
</html>
